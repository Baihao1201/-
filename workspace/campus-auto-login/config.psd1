@{
    # ============================================================
    #  校园网自动登录 - 配置文件
    #  换电脑 / 给同学用：只改这个文件即可，不用动脚本。
    #  改完保存，无需重新安装（脚本每次运行都会重新读取）。
    # ============================================================

    # -------- 认证账号（必改）--------
    account  = '42306099'      # 学号 / 上网账号
    password = '123456789'     # 上网密码
    # 运营商：'unicom'=中国联通   'mobile'=中国移动   'telecom'=中国电信   ''=校园网(默认出口)
    carrier  = 'unicom'

    # -------- 认证服务器（一般不用改）--------
    portalHost  = '202.117.144.205'
    portalPorts = @(8603, 8602, 8601)   # 端口优先级，前面的先试

    # -------- 外网检测目标（能打开任意一个就认为已联网）--------
    # 用于判断"现在到底能不能上网"；换到别的学校也能用，如需可自行替换。
    internetTargets = @(
        'http://www.msftconnecttest.com/connecttest.txt',
        'https://www.baidu.com',
        'https://www.taobao.com'
    )

    # -------- 时间与重试参数（单位：秒）--------
    waitReadySec       = 60   # 连上网络后，等待本机拿到 IP/路由的最长时间
    portalTimeoutSec   = 6    # 向门户发请求的超时
    internetTimeoutSec = 4    # 外网检测的超时
    maxRounds          = 8    # 登录失败时最多重试多少轮
    retryDelaySec      = 3    # 每轮之间的间隔
}
